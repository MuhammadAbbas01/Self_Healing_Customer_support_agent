# Copy to .env and fill in. Never commit .env.
# Postgres / Supabase (use the pooler connection string, port 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# LLM + sandbox
GROQ_API_KEY=your_groq_api_key
E2B_API_KEY=your_e2b_api_key

# LangSmith tracing
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=AI-Support-Agent

# Grafana Cloud metrics
GRAFANA_URL=https://YOUR-STACK.grafana.net/...
GRAFANA_USER=your_grafana_user_id
GRAFANA_TOKEN=your_grafana_token

# Key that clients must send in the x-api-key header
APP_API_KEY=choose_a_long_random_string

# Optional
PORT=8000